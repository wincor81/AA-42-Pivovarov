#include <ros/ros.h>
#include <geometry_msgs/PoseStamped.h>
#include <nav_msgs/Odometry.h>
#include <fstream>
#include <cmath>
#include <vector>

struct Point { double x, y, z; };
Point current_pos;
bool odom_received = false;

void odomCallback(const nav_msgs::Odometry::ConstPtr& msg) {
    current_pos.x = msg->pose.pose.position.x;
    current_pos.y = msg->pose.pose.position.y;
    current_pos.z = msg->pose.pose.position.z;
    odom_received = true;
}

double getDistance(Point p1, Point p2) {
    return std::sqrt(std::pow(p1.x - p2.x, 2) + std::pow(p1.y - p2.y, 2) + std::pow(p1.z - p2.z, 2));
}

int main(int argc, char** argv) {
    ros::init(argc, argv, "mission_node");
    ros::NodeHandle nh("~");

    ros::Subscriber odom_sub = nh.subscribe("/drone_0_visual_slam/odom", 10, odomCallback);
    ros::Publisher goal_pub = nh.advertise<geometry_msgs::PoseStamped>("/move_base_simple/goal", 10);

    std::vector<Point> waypoints(4);
    nh.param("A_x", waypoints[0].x, 0.0); nh.param("A_y", waypoints[0].y, 0.0); nh.param("A_z", waypoints[0].z, 1.0);
    nh.param("B_x", waypoints[1].x, 5.0); nh.param("B_y", waypoints[1].y, 0.0); nh.param("B_z", waypoints[1].z, 1.0);
    nh.param("C_x", waypoints[2].x, 5.0); nh.param("C_y", waypoints[2].y, 5.0); nh.param("C_z", waypoints[2].z, 1.0);
    nh.param("D_x", waypoints[3].x, 0.0); nh.param("D_y", waypoints[3].y, 5.0); nh.param("D_z", waypoints[3].z, 1.0);
    
    std::vector<Point> route = {waypoints[0], waypoints[1], waypoints[2], waypoints[3], waypoints[0]};
    
    std::ofstream csv_file("flight_log.csv");
    csv_file << "Time,X,Y,Z,GoalNum,Distance\n";

    ros::Rate rate(10); // 100 ms
    double total_distance = 0.0;
    std::vector<double> segment_times;
    
    while (ros::ok() && !odom_received) {
        ros::spinOnce();
        rate.sleep();
    }

    ros::Time start_time = ros::Time::now();
    ros::Time segment_start = start_time;
    Point last_pos = current_pos;

    for (size_t i = 0; i < route.size(); ++i) {
        geometry_msgs::PoseStamped goal;
        goal.header.frame_id = "world";
        goal.pose.position.x = route[i].x;
        goal.pose.position.y = route[i].y;
        goal.pose.position.z = route[i].z;
        ROS_INFO("Going to goal %zu: [%.1f, %.1f, %.1f]", i, route[i].x, route[i].y, route[i].z);

        ros::Time hover_start;
        bool hovering = false;

        while (ros::ok()) {
            ros::spinOnce();
            double dist = getDistance(current_pos, route[i]);
            total_distance += getDistance(current_pos, last_pos);
            last_pos = current_pos;
            
            double elapsed = (ros::Time::now() - start_time).toSec();
            csv_file << elapsed << "," << current_pos.x << "," << current_pos.y << "," 
                     << current_pos.z << "," << i << "," << dist << "\n";

            if (dist < 1.5) {
                if (!hovering) {
                    hover_start = ros::Time::now();
                    hovering = true;
                } else if ((ros::Time::now() - hover_start).toSec() >= 1.0) {
                    break; 
                }
            } else {
                hovering = false; 
            }
            
            goal.header.stamp = ros::Time::now();
     if ((ros::Time::now() - segment_start).toSec() > 6.0) {
    ROS_WARN("Timeout! Shifting point...");
    route[i].x += (current_pos.x - route[i].x) * 0.3;
    route[i].y += (current_pos.y - route[i].y) * 0.3;
    goal.pose.position.x = route[i].x;
    goal.pose.position.y = route[i].y;
    segment_start = ros::Time::now(); 
}
            goal_pub.publish(goal);
            rate.sleep();
        }
        double seg_time = (ros::Time::now() - segment_start).toSec();
        segment_times.push_back(seg_time);
        segment_start = ros::Time::now();
    }
    
    double total_time = (ros::Time::now() - start_time).toSec();
    ROS_INFO("Mission Complete!");
    ROS_INFO("Total Time: %.2f s", total_time);
    ROS_INFO("Total Distance: %.2f m", total_distance);
    for (size_t i = 0; i < segment_times.size(); ++i) {
      ROS_INFO("Segment %zu Time: %.2f s", i, segment_times[i]);
    }
    
    csv_file.close();
    return 0;
}
